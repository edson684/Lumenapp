{
  "appId": "com.lumen.iptv",
  "appName": "Lumen",
  "webDir": "www",
  "backgroundColor": "#0b0b0f",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true
    }
  }
}
